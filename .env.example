# ---------- Database ----------
POSTGRES_USER=cms_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=cms
DATABASE_URL="postgresql://cms_app:change_me_locally@localhost:5432/cms?schema=public"

# ---------- API ----------
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me_too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Throttling
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001
# Comma-separated list of IPs/hostnames allowed to hit the Next.js dev server's
# hot-reload endpoint when you browse it from another machine on the LAN.
ALLOWED_DEV_ORIGINS=

# ---------- AI (Phase 9, disabled for now) ----------
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
