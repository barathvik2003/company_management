{
  "name": "company-management-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @cms/api\" \"npm run dev -w @cms/web\"",
    "build": "npm run build -w @cms/shared && npm run build -w @cms/api && npm run build -w @cms/web",
    "lint": "npm run lint -w @cms/api && npm run lint -w @cms/web",
    "test": "npm run test -w @cms/api",
    "typecheck": "tsc -p apps/api --noEmit && tsc -p apps/web --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "predev": "npm run build -w @cms/shared",
    "pretest": "npm run build -w @cms/shared",
    "postinstall": "npm run build -w @cms/shared"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.10",
    "concurrently": "^8.2.2",
    "prisma": "^5.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcrypt": "^5.1.1"
  },
  "overrides": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/core": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10"
  }
}
