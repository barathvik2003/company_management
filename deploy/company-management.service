# /etc/systemd/system/company-management.service
# Runs the whole stack through docker compose, managed by systemd.
[Unit]
Description=Company Management System
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=cmsapp
WorkingDirectory=/opt/company-management
EnvironmentFile=/etc/company-management/.env
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
